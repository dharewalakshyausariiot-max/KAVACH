# .env.example
MODEL_PROVIDER=openai
MODEL_API_KEY=
MODEL_NAME=your-model-name
# Required only with MODEL_PROVIDER=openai-compatible:
# MODEL_BASE_URL=https://your-provider.example/v1
NEATLOGS_API_KEY=
CRUSTDATA_API_KEY=
SEARCH_API_KEY=
FORENSICS_URL=http://127.0.0.1:8000
FORENSICS_API_KEY=your-foreensics-api-key
# SpiderFoot is configured only in the Python service via its setup scripts.
# Persist state on durable storage in production (default: .data/investigations).
# INVESTIGATION_STATE_DIR=C:/private-data/investigations

# Optional separate hosted OpenAI-compatible explainer (for example, a Qwen instruct model).
# Set the exact provider-supported model ID; no model is selected by default.
EXPLAINER_BASE_URL=
EXPLAINER_MODEL=
EXPLAINER_API_KEY=
# Missing explainer settings use the main model, then a report-derived template.
# CFO cost export is manual; no CFO API key is needed.

# Explicit opt-in for synthetic demo fixtures only.
USE_MOCKS=false
NEXT_HOST=localhost
PORT=3000

# Optional domain-only reverse WHOIS enrichment (paid provider requests).
WHOISXML_API_KEY=

# Defaults; saved Settings override these values.
SUPPORT_EMAIL=
DISPLAY_CURRENCY=USD
USD_INR_RATE=
RETENTION_DAYS=30
